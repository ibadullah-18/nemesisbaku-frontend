.nb-product-detail-page {
  --nb-ink: #171310;
  --nb-muted: #746d68;
  --nb-line: rgba(39, 31, 26, 0.12);
  --nb-paper: #f7f5f2;
  --nb-card: rgba(255, 253, 250, 0.88);
  --nb-wine: #a64a52;
  position: relative;
  overflow: clip;
  padding-bottom: 132px !important;
  background: #fafafa;
  color: var(--nb-ink);
}

.nb-product-detail-page::before {
  display: none;
}

.nb-product-detail {
  position: relative;
  z-index: 1;
}

.nb-product-detail__nav {
  display: flex;
  align-items: center;
  min-height: 54px;
  margin-bottom: 18px;
}

.nb-product-detail__back {
  display: grid;
  width: 46px;
  height: 46px;
  flex: none;
  place-items: center;
  border: 1px solid var(--nb-line);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.68);
  color: var(--nb-ink);
  font-size: 23px;
  cursor: pointer;
  box-shadow: 0 10px 28px rgba(47, 37, 31, 0.055);
  backdrop-filter: blur(12px);
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.nb-product-detail__back:hover {
  transform: translateX(-2px);
  border-color: rgba(39, 31, 26, 0.32);
  background: #fffdfa;
}

.nb-product-detail__back:active {
  transform: scale(0.94);
}

.nb-product-detail__crumbs {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 11px;
  margin-left: 16px;
  color: #8f8882;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.nb-product-detail__crumbs i {
  width: 22px;
  height: 1px;
  background: #c9c1bb;
}

.nb-product-detail__crumbs strong {
  min-width: 0;
  overflow: hidden;
  color: #514b47;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nb-product-detail__layout {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(390px, 0.75fr);
  align-items: start;
  gap: clamp(22px, 3vw, 46px);
}

.nb-product-gallery {
  min-width: 0;
  animation: nbProductRise 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.nb-product-gallery__stage {
  --gallery-rx: 0deg;
  --gallery-ry: 0deg;
  --gallery-light-x: 50%;
  --gallery-light-y: 42%;
  position: relative;
  isolation: isolate;
  min-height: min(670px, 67vw);
  overflow: hidden;
  border: 1px solid rgba(47, 37, 31, 0.07);
  border-radius: clamp(22px, 3vw, 38px);
  background:
    radial-gradient(
      circle at var(--gallery-light-x) var(--gallery-light-y),
      rgba(255, 255, 255, 0.9),
      transparent 32%
    ),
    linear-gradient(145deg, #eee6df 0%, #f8f4ef 52%, #e9dfd6 100%);
  box-shadow: 0 38px 90px rgba(68, 51, 41, 0.12);
  perspective: 1200px;
}

.nb-product-gallery__stage::before {
  content: "";
  position: absolute;
  z-index: 0;
  right: -18%;
  bottom: -35%;
  width: 90%;
  aspect-ratio: 1;
  border: 1px solid rgba(77, 56, 46, 0.11);
  border-radius: 50%;
  box-shadow:
    0 0 0 50px rgba(255, 255, 255, 0.12),
    0 0 0 100px rgba(80, 60, 49, 0.025);
}

.nb-product-gallery__stage::after {
  content: "";
  position: absolute;
  z-index: 2;
  left: 17%;
  right: 12%;
  bottom: 12%;
  height: 8%;
  border-radius: 50%;
  background: rgba(45, 31, 24, 0.18);
  filter: blur(26px);
  transform: rotate(-2deg);
  pointer-events: none;
}

.nb-product-gallery__image-button {
  position: absolute;
  z-index: 3;
  inset: 0;
  display: grid;
  width: 100%;
  height: 100%;
  place-items: center;
  border: 0;
  padding: clamp(52px, 7vw, 105px) clamp(24px, 4vw, 70px)
    clamp(64px, 8vw, 112px);
  background: transparent;
  cursor: zoom-in;
  transform: rotateX(var(--gallery-rx)) rotateY(var(--gallery-ry));
  transform-style: preserve-3d;
  transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
}

.nb-product-gallery__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 34px 30px rgba(43, 31, 24, 0.19));
  transform: translateZ(45px);
  will-change: transform;
  animation: nbProductImageIn 620ms cubic-bezier(0.22, 1, 0.36, 1) both;
  transition:
    transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
    filter 360ms ease;
}

.nb-product-gallery__image-button:hover .nb-product-gallery__image {
  filter: drop-shadow(0 42px 34px rgba(43, 31, 24, 0.23));
}

.nb-product-gallery__empty {
  color: rgba(50, 40, 34, 0.22);
  font:
    700 clamp(23px, 4vw, 54px)/1 Georgia,
    serif;
  letter-spacing: -0.055em;
}

.nb-product-gallery__word {
  position: absolute;
  z-index: 1;
  top: 10%;
  left: 5%;
  color: rgba(84, 64, 53, 0.055);
  font:
    700 clamp(48px, 8vw, 118px)/0.78 Georgia,
    serif;
  letter-spacing: -0.07em;
  transform: rotate(-90deg) translateX(-100%);
  transform-origin: top left;
  user-select: none;
}

.nb-product-gallery__orb {
  position: absolute;
  z-index: 1;
  border: 1px solid rgba(73, 55, 45, 0.08);
  border-radius: 50%;
  pointer-events: none;
}

.nb-product-gallery__orb--one {
  top: 9%;
  right: 9%;
  width: 11%;
  aspect-ratio: 1;
  background: rgba(255, 255, 255, 0.34);
  box-shadow: inset 0 0 22px rgba(255, 255, 255, 0.7);
  animation: nbProductFloat 7s ease-in-out infinite;
}

.nb-product-gallery__orb--two {
  right: 21%;
  bottom: 21%;
  width: 5%;
  aspect-ratio: 1;
  background: rgba(163, 75, 83, 0.1);
  animation: nbProductFloat 6s 1.2s ease-in-out infinite reverse;
}

.nb-product-gallery__sale {
  position: absolute;
  z-index: 6;
  top: 22px;
  left: 22px;
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  border-radius: 999px;
  padding: 0 12px;
  background: var(--nb-wine);
  color: #fff;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.08em;
  box-shadow: 0 10px 24px rgba(166, 74, 82, 0.22);
}

.nb-product-gallery__foot {
  position: absolute;
  z-index: 7;
  right: 22px;
  bottom: 20px;
  left: 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

.nb-product-gallery__foot > span {
  color: #625a55;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.nb-product-gallery__foot button {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  gap: 8px;
  border: 1px solid rgba(37, 29, 24, 0.1);
  border-radius: 999px;
  padding: 0 14px;
  background: rgba(255, 253, 250, 0.72);
  color: #322b27;
  font: inherit;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  pointer-events: auto;
  backdrop-filter: blur(14px);
  transition:
    transform 180ms ease,
    background 180ms ease;
}

.nb-product-gallery__foot button:hover {
  transform: translateY(-2px);
  background: #fffdfa;
}

.nb-product-gallery__thumbs {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
  margin-top: 12px;
  overflow-x: auto;
  overscroll-behavior-inline: contain;
  scrollbar-width: none;
}

.nb-product-gallery__thumbs::-webkit-scrollbar {
  display: none;
}

.nb-product-gallery__thumbs button {
  position: relative;
  min-width: 90px;
  aspect-ratio: 1.22;
  overflow: hidden;
  border: 1px solid rgba(43, 33, 28, 0.07);
  border-radius: 15px;
  padding: 0;
  background: #efe8e2;
  cursor: pointer;
  transition:
    transform 220ms ease,
    border-color 220ms ease,
    box-shadow 220ms ease;
}

.nb-product-gallery__thumbs button:hover,
.nb-product-gallery__thumbs button.is-active {
  transform: translateY(-2px);
  border-color: rgba(36, 27, 23, 0.58);
  box-shadow: 0 12px 26px rgba(60, 44, 35, 0.11);
}

.nb-product-gallery__thumbs img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.nb-product-gallery__thumbs span {
  position: absolute;
  right: 6px;
  bottom: 5px;
  display: grid;
  min-width: 22px;
  height: 18px;
  place-items: center;
  border-radius: 99px;
  background: rgba(255, 255, 255, 0.82);
  color: #2e2723;
  font-size: 8px;
  font-weight: 900;
  backdrop-filter: blur(8px);
}

.nb-product-info {
  position: sticky;
  top: 112px;
  min-width: 0;
  border: 1px solid rgba(50, 38, 31, 0.08);
  border-radius: clamp(22px, 2.5vw, 34px);
  padding: clamp(24px, 3vw, 40px);
  background: var(--nb-card);
  box-shadow: 0 30px 80px rgba(61, 46, 37, 0.09);
  backdrop-filter: blur(22px);
  animation: nbProductRise 760ms 90ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.nb-product-info__topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
}

.nb-product-info__topline > div {
  min-width: 0;
}

.nb-product-info__topline p {
  margin: 0;
  overflow: hidden;
  color: #827970;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.17em;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.nb-product-info__topline span {
  display: block;
  margin-top: 5px;
  color: #aba39d;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.nb-product-info__favorite {
  display: grid;
  width: 48px;
  height: 48px;
  flex: none;
  place-items: center;
  border: 1px solid var(--nb-line);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  color: #221d1a;
  font-size: 20px;
  cursor: pointer;
  transition:
    transform 200ms ease,
    color 200ms ease,
    border-color 200ms ease,
    background 200ms ease;
}

.nb-product-info__favorite:hover {
  transform: rotate(-7deg) scale(1.06);
  border-color: rgba(166, 74, 82, 0.35);
}

.nb-product-info__favorite.is-active {
  border-color: rgba(166, 74, 82, 0.22);
  background: rgba(166, 74, 82, 0.08);
  color: #b33f49;
}

.nb-product-info__favorite:disabled {
  cursor: wait;
  opacity: 0.55;
}

.nb-product-info h1 {
  max-width: 12ch;
  margin: 19px 0 0;
  overflow-wrap: anywhere;
  font:
    500 clamp(38px, 4vw, 62px)/0.98 Georgia,
    "Times New Roman",
    serif;
  letter-spacing: -0.062em;
}

.nb-product-info__price {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
  margin-top: 21px;
}

.nb-product-info__price strong {
  color: var(--nb-ink);
  font-size: clamp(25px, 2.2vw, 34px);
  font-weight: 800;
  letter-spacing: -0.045em;
}

.nb-product-info__price del {
  color: #a49b94;
  font-size: 14px;
  font-weight: 650;
}

.nb-product-info__price span {
  display: inline-flex;
  min-height: 25px;
  align-items: center;
  border-radius: 999px;
  padding: 0 9px;
  background: rgba(166, 74, 82, 0.1);
  color: var(--nb-wine);
  font-size: 10px;
  font-weight: 900;
}

.nb-product-info__description {
  margin-top: 19px;
  color: var(--nb-muted);
  font-size: 14px;
  line-height: 1.75;
}

.nb-product-info__description > div {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.nb-product-info__description > div.is-clamped {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.nb-product-info__description button {
  margin-top: 5px;
  border: 0;
  border-bottom: 1px solid currentColor;
  padding: 0;
  background: none;
  color: #28211d;
  font: inherit;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

.nb-product-info__rule {
  height: 1px;
  margin: 25px 0 23px;
  background: var(--nb-line);
}

.nb-product-option + .nb-product-option {
  margin-top: 23px;
}

.nb-product-option__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 12px;
}

.nb-product-option__head > span {
  color: #3a322e;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.nb-product-option__head strong {
  overflow: hidden;
  color: #817872;
  font-size: 11px;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nb-product-colors,
.nb-product-sizes {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.nb-product-colors button {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 50%;
  padding: 0;
  background: transparent;
  cursor: pointer;
  transition:
    border-color 180ms ease,
    transform 180ms ease;
}

.nb-product-colors button:hover {
  transform: scale(1.07);
}

.nb-product-colors button.is-active {
  border-color: #29211d;
}

.nb-product-colors button span {
  width: 28px;
  height: 28px;
  border: 2px solid #fff;
  border-radius: 50%;
  box-shadow:
    0 0 0 1px rgba(37, 29, 25, 0.12),
    0 5px 12px rgba(43, 31, 25, 0.12);
}

.nb-product-sizes button {
  position: relative;
  display: grid;
  min-width: 54px;
  height: 49px;
  place-items: center;
  border: 1px solid var(--nb-line);
  border-radius: 13px;
  padding: 0 13px;
  background: rgba(255, 255, 255, 0.55);
  color: #403833;
  font: inherit;
  font-size: 13px;
  font-weight: 750;
  cursor: pointer;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    color 180ms ease;
}

.nb-product-sizes button:hover {
  transform: translateY(-2px);
  border-color: rgba(36, 28, 24, 0.42);
}

.nb-product-sizes button.is-active {
  border-color: #1d1815;
  background: #1d1815;
  color: #fff;
  box-shadow: 0 9px 20px rgba(29, 24, 21, 0.16);
}

.nb-product-sizes small {
  position: absolute;
  top: -8px;
  right: -7px;
  display: inline-flex;
  height: 20px;
  min-width: 22px;
  align-items: center;
  justify-content: center;
  gap: 1px;
  border: 2px solid #fffdfa;
  border-radius: 999px;
  padding: 0 4px;
  background: var(--nb-wine);
  color: #fff;
  font-size: 8px;
  font-weight: 900;
  animation: nbStockPulse 1.7s ease-in-out infinite;
}

.nb-product-buy-dock {
  --nb-line: rgba(39, 31, 26, 0.12);
  position: fixed;
  z-index: 120;
  right: 24px;
  bottom: calc(env(safe-area-inset-bottom) + 24px);
  display: grid;
  grid-template-columns: 126px minmax(230px, 290px);
  gap: 8px;
  border: 1px solid rgba(39, 31, 26, 0.1);
  border-radius: 22px;
  padding: 8px;
  background: rgba(255, 253, 250, 0.92);
  box-shadow: 0 22px 55px rgba(38, 29, 24, 0.19);
  pointer-events: auto;
  touch-action: manipulation;
  isolation: isolate;
  backdrop-filter: blur(18px);
  animation: nbProductDockIn 560ms 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.nb-product-quantity {
  display: grid;
  grid-template-columns: 38px 1fr 38px;
  min-width: 0;
  height: 56px;
  overflow: hidden;
  border: 1px solid var(--nb-line);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.65);
}

.nb-product-quantity button {
  position: relative;
  z-index: 2;
  display: grid;
  place-items: center;
  border: 0;
  background: transparent;
  color: #29231f;
  cursor: pointer;
  touch-action: manipulation;
  transition:
    background 180ms ease,
    transform 180ms ease;
}

.nb-product-quantity button:hover {
  background: rgba(40, 31, 26, 0.05);
}

.nb-product-quantity button:active {
  transform: scale(0.87);
}

.nb-product-quantity span {
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 850;
}

.nb-product-add,
.nb-product-whatsapp {
  display: flex;
  min-width: 0;
  height: 56px;
  align-items: center;
  justify-content: space-between;
  border: 0;
  border-radius: 15px;
  padding: 0 18px;
  font: inherit;
  font-size: 13px;
  font-weight: 850;
  cursor: pointer;
  touch-action: manipulation;
  transition:
    transform 190ms ease,
    box-shadow 190ms ease,
    background 190ms ease;
}

.nb-product-add {
  background: #1b1715;
  color: #fff;
  box-shadow: 0 14px 27px rgba(29, 23, 20, 0.17);
}

.nb-product-add > span,
.nb-product-whatsapp > span {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  gap: 9px;
}

.nb-product-add:hover,
.nb-product-whatsapp:hover {
  transform: translateY(-2px);
}

.nb-product-add:hover {
  background: #2d2622;
  box-shadow: 0 18px 33px rgba(29, 23, 20, 0.22);
}

.nb-product-add.is-success {
  background: #44735a;
}

.nb-product-add:disabled {
  cursor: wait;
  opacity: 0.6;
}

.nb-product-whatsapp {
  width: 100%;
  margin-top: 10px;
  border: 1px solid rgba(39, 133, 75, 0.18);
  background: rgba(39, 183, 90, 0.09);
  color: #267445;
}

.nb-product-whatsapp > span > svg {
  font-size: 20px;
}

.nb-product-whatsapp:hover {
  background: rgba(39, 183, 90, 0.14);
}

.nb-product-assurances {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
  animation: nbProductRise 720ms 150ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.nb-product-assurances > button {
  position: relative;
  display: grid;
  min-height: 154px;
  grid-template-columns: 44px minmax(0, 1fr) 20px;
  align-items: start;
  gap: 13px;
  overflow: hidden;
  border: 1px solid rgba(39, 31, 26, 0.09);
  border-radius: 20px;
  padding: 24px 20px 20px;
  background: #fff;
  color: #2a2420;
  font: inherit;
  text-align: left;
  cursor: pointer;
  box-shadow: 0 13px 35px rgba(47, 36, 30, 0.045);
  transition:
    transform 240ms ease,
    border-color 240ms ease,
    box-shadow 240ms ease;
}

.nb-product-assurances > button::after {
  position: absolute;
  right: -28px;
  bottom: -38px;
  width: 105px;
  aspect-ratio: 1;
  border: 1px solid rgba(92, 70, 58, 0.06);
  border-radius: 50%;
  content: "";
  pointer-events: none;
}

.nb-product-assurances > button:hover {
  transform: translateY(-4px);
  border-color: rgba(39, 31, 26, 0.2);
  box-shadow: 0 20px 45px rgba(47, 36, 30, 0.08);
}

.nb-product-assurances__number {
  position: absolute;
  top: 11px;
  right: 14px;
  color: rgba(52, 42, 36, 0.24);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.13em;
}

.nb-product-assurances__icon {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border-radius: 14px;
  background: #f3efeb;
  color: #493f39;
  font-size: 19px;
}

.nb-product-assurances__copy {
  display: block;
  min-width: 0;
}

.nb-product-assurances__copy strong,
.nb-product-assurances__copy small {
  display: block;
}

.nb-product-assurances__copy strong {
  margin-top: 2px;
  color: #211c19;
  font-size: 14px;
  font-weight: 850;
  letter-spacing: -0.015em;
}

.nb-product-assurances__copy small {
  display: -webkit-box;
  margin-top: 8px;
  overflow: hidden;
  color: #837b75;
  font-size: 10px;
  font-weight: 650;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.nb-product-assurances__arrow {
  margin-top: 12px;
  color: #746b65;
  font-size: 16px;
  transition: transform 200ms ease;
}

.nb-product-assurances > button:hover .nb-product-assurances__arrow {
  transform: translate(2px, -2px);
}

.nb-product-info__signature {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 26px;
  color: #9a918b;
}

.nb-product-info__signature span {
  color: #312a26;
  font:
    700 13px/1 Georgia,
    serif;
  letter-spacing: -0.035em;
}

.nb-product-info__signature i {
  width: 24px;
  height: 1px;
  background: #d0c8c2;
}

.nb-product-info__signature small {
  overflow: hidden;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.14em;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}

.nb-product-related {
  margin-top: clamp(58px, 7vw, 104px);
  animation: nbProductRise 760ms 180ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.nb-product-related__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 23px;
}

.nb-product-related__head span {
  color: #9c5a5f;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.19em;
  text-transform: uppercase;
}

.nb-product-related__head h2 {
  margin: 7px 0 0;
  font:
    500 clamp(31px, 4vw, 51px)/1 Georgia,
    "Times New Roman",
    serif;
  letter-spacing: -0.055em;
}

.nb-product-related__head p {
  margin: 0 0 5px;
  color: #938b85;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.nb-product-related__track {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  padding: 2px 2px 22px;
  scroll-behavior: smooth;
  scroll-snap-type: x proximity;
  scrollbar-color: rgba(53, 42, 35, 0.26) transparent;
  scrollbar-width: thin;
}

.nb-product-related__card,
.nb-product-related__more-wrap {
  width: 245px;
  min-width: 245px;
  scroll-snap-align: start;
}

.nb-product-related__card > a {
  border-color: rgba(60, 46, 38, 0.08);
  background: rgba(255, 253, 250, 0.74);
  box-shadow: 0 15px 36px rgba(59, 44, 35, 0.065);
}

.nb-product-related__more-wrap {
  display: grid;
  place-items: center;
}

.nb-product-related__more-wrap button {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  gap: 9px;
  border: 1px solid var(--nb-line);
  border-radius: 999px;
  padding: 0 19px;
  background: rgba(255, 255, 255, 0.65);
  color: #29221f;
  font: inherit;
  font-size: 12px;
  font-weight: 850;
  cursor: pointer;
  transition:
    transform 180ms ease,
    background 180ms ease;
}

.nb-product-related__more-wrap button:hover {
  transform: translateY(-2px);
  background: #fff;
}

.nb-product-modal {
  position: fixed;
  z-index: 99999;
  inset: 0;
  display: flex;
  width: 100vw;
  height: 100dvh;
  touch-action: none;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: clamp(16px, 5vw, 64px);
  background:
    radial-gradient(circle at 50% 45%, rgba(83, 67, 56, 0.38), transparent 42%),
    #100e0d;
}

.nb-product-modal::before {
  content: "nemesisbaku";
  position: absolute;
  top: 26px;
  left: 30px;
  color: rgba(255, 255, 255, 0.78);
  font:
    700 18px/1 Georgia,
    serif;
  letter-spacing: -0.04em;
}

.nb-product-modal__image {
  display: block;
  max-width: min(86vw, 1200px);
  max-height: 86dvh;
  user-select: none;
  border-radius: 20px;
  object-fit: contain;
  filter: drop-shadow(0 30px 45px rgba(0, 0, 0, 0.28));
  animation: nbProductModalIn 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

.nb-product-modal__close,
.nb-product-modal__arrow {
  position: fixed;
  z-index: 100002;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  cursor: pointer;
  backdrop-filter: blur(16px);
  transition:
    transform 180ms ease,
    background 180ms ease;
}

.nb-product-modal__close:hover,
.nb-product-modal__arrow:hover {
  transform: scale(1.07);
  background: rgba(255, 255, 255, 0.16);
}

.nb-product-modal__close {
  top: 20px;
  right: 22px;
  width: 48px;
  height: 48px;
  font-size: 25px;
}

.nb-product-modal__arrow {
  top: 50%;
  width: 52px;
  height: 52px;
  font-size: 26px;
}

.nb-product-modal__arrow--prev {
  left: 22px;
  transform: translateY(-50%);
}

.nb-product-modal__arrow--next {
  right: 22px;
  transform: translateY(-50%);
}

.nb-product-modal__arrow--prev:hover,
.nb-product-modal__arrow--next:hover {
  transform: translateY(-50%) scale(1.07);
}

.nb-product-modal__counter {
  position: fixed;
  z-index: 100002;
  right: 0;
  bottom: 24px;
  left: 0;
  color: rgba(255, 255, 255, 0.64);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.18em;
  text-align: center;
}

@keyframes nbProductRise {
  from {
    opacity: 0;
    transform: translateY(24px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes nbProductImageIn {
  from {
    opacity: 0;
    filter: blur(7px) drop-shadow(0 22px 22px rgba(43, 31, 24, 0.12));
  }
  to {
    opacity: 1;
    filter: blur(0) drop-shadow(0 34px 30px rgba(43, 31, 24, 0.19));
  }
}

@keyframes nbProductModalIn {
  from {
    opacity: 0;
    transform: scale(0.94);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes nbProductFloat {
  0%,
  100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(0, -11px, 18px);
  }
}

@keyframes nbStockPulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(166, 74, 82, 0.22);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(166, 74, 82, 0);
  }
}

@keyframes nbProductDockIn {
  from {
    opacity: 0;
    transform: translateY(22px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 1023px) {
  .nb-product-detail__layout {
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.8fr);
    gap: 20px;
  }

  .nb-product-gallery__stage {
    min-height: 570px;
  }

  .nb-product-info {
    top: 92px;
    padding: 25px;
  }

  .nb-product-info h1 {
    font-size: clamp(35px, 4vw, 46px);
  }

  .nb-product-add {
    padding-inline: 15px;
  }
}

@media (max-width: 820px) {
  .nb-product-detail__layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .nb-product-gallery__stage {
    min-height: 0;
    aspect-ratio: 1 / 1.08;
  }

  .nb-product-info {
    position: relative;
    top: auto;
  }

  .nb-product-gallery__thumbs {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(86px, 19%);
  }

  .nb-product-assurances {
    grid-template-columns: minmax(0, 1fr);
  }

  .nb-product-assurances > button {
    min-height: 126px;
  }

  .nb-product-buy-dock {
    right: auto;
    bottom: calc(env(safe-area-inset-bottom) + 12px);
    left: 50%;
    width: min(420px, calc(100vw - 24px));
    grid-template-columns: 116px minmax(0, 1fr);
    border-radius: 20px;
    padding: 7px;
    transform: translateX(-50%);
    animation-name: nbProductDockInMobile;
  }
}

@media (max-width: 560px) {
  .nb-product-detail-page {
    padding-right: 12px !important;
    padding-left: 12px !important;
  }

  .nb-product-detail__nav {
    min-height: 45px;
    margin-bottom: 12px;
  }

  .nb-product-detail__back {
    width: 42px;
    height: 42px;
  }

  .nb-product-detail__crumbs {
    gap: 8px;
    margin-left: 10px;
    font-size: 8px;
    letter-spacing: 0.12em;
  }

  .nb-product-detail__crumbs i {
    width: 13px;
  }

  .nb-product-detail__layout {
    gap: 14px;
  }

  .nb-product-gallery__stage {
    border-radius: 24px;
    box-shadow: 0 22px 58px rgba(68, 51, 41, 0.11);
  }

  .nb-product-gallery__stage::after {
    filter: blur(18px);
  }

  .nb-product-gallery__image-button {
    padding: 44px 24px 64px;
    transform: none;
  }

  .nb-product-gallery__image {
    filter: drop-shadow(0 22px 20px rgba(43, 31, 24, 0.17));
  }

  .nb-product-gallery__word {
    top: 11%;
    left: 5%;
    font-size: 52px;
  }

  .nb-product-gallery__sale {
    top: 15px;
    left: 15px;
    min-height: 29px;
    font-size: 10px;
  }

  .nb-product-gallery__foot {
    right: 15px;
    bottom: 14px;
    left: 15px;
  }

  .nb-product-gallery__foot button {
    min-height: 34px;
    padding-inline: 11px;
  }

  .nb-product-gallery__thumbs {
    gap: 7px;
    margin-top: 8px;
    grid-auto-columns: 25%;
  }

  .nb-product-gallery__thumbs button {
    min-width: 76px;
    border-radius: 12px;
  }

  .nb-product-info {
    border-radius: 24px;
    padding: 22px 18px;
    backdrop-filter: none;
  }

  .nb-product-info__favorite {
    width: 44px;
    height: 44px;
  }

  .nb-product-info h1 {
    max-width: 10.5ch;
    margin-top: 16px;
    font-size: clamp(36px, 12vw, 50px);
  }

  .nb-product-info__price {
    margin-top: 17px;
  }

  .nb-product-info__rule {
    margin: 22px 0 20px;
  }

  .nb-product-quantity {
    grid-template-columns: 40px 1fr 40px;
    height: 54px;
  }

  .nb-product-add,
  .nb-product-whatsapp {
    height: 54px;
    padding-inline: 14px;
    font-size: 12px;
  }

  .nb-product-related {
    margin-top: 56px;
  }

  .nb-product-related__head {
    align-items: flex-end;
    margin-inline: 4px;
  }

  .nb-product-related__head h2 {
    max-width: 10ch;
    font-size: 34px;
  }

  .nb-product-related__card,
  .nb-product-related__more-wrap {
    width: 71vw;
    min-width: 71vw;
  }

  .nb-product-modal {
    padding: 8px;
  }

  .nb-product-modal::before {
    top: 23px;
    left: 18px;
    font-size: 15px;
  }

  .nb-product-modal__close {
    top: 14px;
    right: 14px;
    width: 43px;
    height: 43px;
  }

  .nb-product-modal__arrow {
    display: none;
  }

  .nb-product-modal__image {
    max-width: 96vw;
    max-height: 82dvh;
    border-radius: 14px;
  }
}

@keyframes nbProductDockInMobile {
  from {
    opacity: 0;
    transform: translate(-50%, 22px) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
}

@media (hover: none), (pointer: coarse) {
  .nb-product-gallery__image-button {
    transform: none;
  }

  .nb-product-gallery__image-button:hover .nb-product-gallery__image {
    filter: drop-shadow(0 24px 24px rgba(43, 31, 24, 0.18));
  }
}

@media (prefers-reduced-motion: reduce) {
  .nb-product-gallery,
  .nb-product-info,
  .nb-product-related,
  .nb-product-assurances,
  .nb-product-buy-dock,
  .nb-product-gallery__image,
  .nb-product-modal__image,
  .nb-product-gallery__orb,
  .nb-product-sizes small {
    animation: none !important;
  }

  .nb-product-gallery__image-button,
  .nb-product-gallery__image,
  .nb-product-detail__back,
  .nb-product-info__favorite,
  .nb-product-sizes button,
  .nb-product-add,
  .nb-product-whatsapp {
    transition-duration: 1ms !important;
  }
}
